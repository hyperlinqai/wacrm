# Copy to .env and fill in. Generate JWT_SECRET / keys with:
#   node ../../scripts/generate-supabase-keys.mjs

# External Postgres (stock, already migrated via scripts/apply-postgres.sh)
POSTGRES_HOST=your-postgres-host
POSTGRES_PORT=5432
POSTGRES_DB=wa-crm
# Shared password for the supabase_* service roles
# (what you passed as svc_password to 010_service_roles.sql)
SVC_PASSWORD=change-me

# JWT (shared by all services and the Next.js app)
JWT_SECRET=change-me
ANON_KEY=change-me
SERVICE_ROLE_KEY=change-me
SECRET_KEY_BASE=change-me-64-hex-chars

# URLs
GATEWAY_PORT=8000
# Where browsers/the app reach this gateway
API_EXTERNAL_URL=http://localhost:8000
# Where the Next.js app itself is served
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=
