{
  "name": "wacrm-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "wacrm monorepo \u2014 the UI (apps/web), the HTTP API (apps/api), the MCP server (apps/mcp-server), and shared packages.",
  "license": "MIT",
  "author": "Arnas Donauskas",
  "homepage": "https://github.com/ArnasDon/wacrm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArnasDon/wacrm.git"
  },
  "bugs": {
    "url": "https://github.com/ArnasDon/wacrm/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.9.9",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "ulimit -n 65536 2>/dev/null || true; turbo run dev --filter=!wacrm-mcp",
    "dev:web": "ulimit -n 65536 2>/dev/null || true; npm run dev --workspace=apps/web",
    "dev:api": "ulimit -n 65536 2>/dev/null || true; npm run dev --workspace=apps/api",
    "build": "turbo run build",
    "start": "turbo run start --filter=!wacrm-mcp",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "ip-address": "^10.3.1",
    "fast-uri": "^3.1.5",
    "hono": "^4.12.34",
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.17",
    "@babel/core": "^7.29.6",
    "sharp": "^0.35.3",
    "brace-expansion@^1.0.0": "^1.1.18",
    "brace-expansion@^5.0.0": "^5.0.9",
    "@modelcontextprotocol/sdk": {
      "zod": "3.25.76"
    },
    "eslint-plugin-react-hooks": "7.0.1"
  }
}
